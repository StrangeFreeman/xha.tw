---
import { cmsPage } from '@/cms-config'
import { isPreview } from '@/utils/preview'

import PageLayout from '@/layouts/CommonPage.astro'
import PageBlocks from '@/components/blocks/PageBlocks.astro'
import { getBlockHeadings } from '@/utils/page-blocks'

if (!cmsPage.about.enabled && !isPreview) return Astro.redirect('/404')
const headings = getBlockHeadings(cmsPage.about.blocks)
---

<PageLayout
  title={cmsPage.about.title}
  description={cmsPage.about.description}
  {headings}
  view={cmsPage.about.view}
  comment={cmsPage.about.comment}
>
  <PageBlocks blocks={cmsPage.about.blocks} />
</PageLayout>

---
import { getCollection, render } from 'astro:content'
import { cmsPage } from '@/cms-config'

import PageLayout from '@/layouts/CommonPage.astro'

if (!cmsPage.about.enabled) return Astro.redirect('/404')

const sections = await Promise.all(
  (await getCollection('aboutSections'))
    .filter(({ data }) => data.visible)
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ entry, ...(await render(entry)) }))
)
const headings = sections.flatMap(({ entry, headings: nestedHeadings }) => [
  { depth: 2, slug: entry.data.slug, text: entry.data.title },
  ...nestedHeadings
])
---

<PageLayout
  title={cmsPage.about.title}
  description={cmsPage.about.description}
  {headings}
  view={cmsPage.about.view}
  comment={cmsPage.about.comment}
>
  {
    sections.map(({ entry, Content }) => (
      <section>
        <h2 id={entry.data.slug}>{entry.data.title}</h2>
        <Content />
      </section>
    ))
  }
</PageLayout>

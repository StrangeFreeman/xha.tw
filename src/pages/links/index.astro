---
import { cmsPage } from '@/cms-config'
import { isPreview } from '@/utils/preview'

import PageLayout from '@/layouts/CommonPage.astro'
import PageBlocks from '@/components/blocks/PageBlocks.astro'
import { getBlockHeadings } from '@/utils/page-blocks'

if (!cmsPage.links.enabled && !isPreview) return Astro.redirect('/404')
const headings = getBlockHeadings(cmsPage.links.blocks)
---

<PageLayout
  title={cmsPage.links.title}
  description={cmsPage.links.description}
  {headings}
  view={cmsPage.links.view}
  comment={cmsPage.links.comment}
>
  <PageBlocks blocks={cmsPage.links.blocks} />
</PageLayout>
